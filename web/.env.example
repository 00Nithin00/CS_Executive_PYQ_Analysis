# Required in production: at least 32 random characters (e.g. `openssl rand -base64 48`)
AUTH_SECRET=
# Public base URL used for metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Data source for subjects/questions/analytics: mock (default) | postgres (not yet implemented)
DATA_PROVIDER=mock
# Account store: file (default, .data/store.json — local/single server only) | postgres (not yet implemented)
USER_STORE=file
# Optional override for the file store location
# FILE_STORE_PATH=
# Used by drizzle-kit once the Postgres store is added
# DATABASE_URL=postgres://user:pass@host:5432/cs_executive
