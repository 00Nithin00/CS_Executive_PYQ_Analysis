# Required in production: at least 32 random characters (e.g. `openssl rand -base64 48`)
AUTH_SECRET=
# Public base URL used for metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Data source for subjects/questions/analytics: mock (default) | postgres (not yet implemented)
DATA_PROVIDER=mock
# Postgres for accounts, subscriptions and personal data (required everywhere).
# Local: createdb atlas_dev && DATABASE_URL=postgres://localhost:5432/atlas_dev npm run db:migrate
# Vercel: injected by the Neon integration — use the POOLED connection string.
DATABASE_URL=postgres://localhost:5432/atlas_dev
# Optional: connections per server instance (default 5)
# DB_POOL_MAX=5
